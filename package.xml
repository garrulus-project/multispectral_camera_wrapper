<?xml version="1.0"?>
<package format="2">
  <name>multispectral_camera_wrapper</name>
  <version>1.0.0</version>
  <description>A ROS2 package for Parrot Sequoia multispectral camera</description>

  <author email="mohammad.wasil@h-brs.de">Mohammad Wasil</author>
  <maintainer email="mohammad.wasil@h-brs.de">Mohammad Wasil</maintainer>

  <license>GPLv3</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>rclpy</build_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
