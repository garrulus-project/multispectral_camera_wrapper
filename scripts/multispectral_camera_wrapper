#!/usr/bin/env python3

import rospy
from multispectral_camera_wrapper.multispectral_camera_wrapper import \
    MultiSpectralCameraWrapper

if __name__ == '__main__':
    rospy.init_node("multispectral_camera_wrapper")
    rate = rospy.get_param("~rate", 30)
    rospy.Rate(rate)
    rospy.loginfo("Multispectral camera wrapper node is running...")

    try:
        ms_wrapper = MultiSpectralCameraWrapper()
        ms_wrapper.initialize()
        while not rospy.is_shutdown():
            rospy.sleep(1.0/rate)
        
        rospy.logwarn("Multispectral camera wrapper node exiting...")
        del ms_wrapper
    except rospy.ROSInterruptException as e:
        rospy.logwarn(f"Multispectral camera wrapper node exiting, {str(e)}")
        rospy.shutdown()
